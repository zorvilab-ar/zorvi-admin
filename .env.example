# Copiá a `.env.local` para desarrollo:
#   cp .env.example .env.local
#
# El admin no tiene credenciales de base: todo pasa por zorvi-backend.

# ── Backend (zorvi-backend) ─────────────────────────────────────────
# El admin ya no habla con Postgres: todo pasa por el backend, que es el
# dueño de los datos. Sin esto, ninguna página carga.
SHOP_API_URL=http://localhost:3001
# El mismo valor que INTERNAL_API_KEY del backend.
SHOP_INTERNAL_KEY=

# ── Supabase Auth + Realtime ────────────────────────────────────────
# Sacá estos valores de Supabase → Project Settings → API. NO commitees los reales.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# Alias que a veces inyecta el Marketplace:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Emails con acceso al panel, separados por coma.
# Si está vacío, entra cualquiera autenticado en Supabase Auth.
ADMIN_EMAILS=you@example.com,teammate@example.com
