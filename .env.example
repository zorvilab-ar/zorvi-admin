# Local: Docker. Producción: Vercel + Supabase (Marketplace).
# Copiá a `.env.local` para desarrollo:
#   cp .env.example .env.local
#
# En Vercel: Integrations → Supabase. Eso inyecta las NEXT_PUBLIC_SUPABASE_*
# y POSTGRES_* . DATABASE_URL se deriva de POSTGRES_URL si no la seteás.

# ── Postgres (Drizzle) ──────────────────────────────────────────────
# Local Docker:
DATABASE_URL=postgres://zorvi:zorvi@127.0.0.1:5433/zorvi

# Vercel / Supabase (el Marketplace suele traer estos nombres):
# DATABASE_URL=
# POSTGRES_URL=
# POSTGRES_PRISMA_URL=
# POSTGRES_URL_NON_POOLING=
# DIRECT_URL=

# ── Supabase Auth + Realtime ────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://yduvfmpuxyjmmkswbjdg.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_Au7lfSLwQL8NQaahqsuQqw_v-auaK5J
# Alias que a veces inyecta el Marketplace:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Emails con acceso al panel, separados por coma.
# Si está vacío, entra cualquiera autenticado en Supabase Auth.
ADMIN_EMAILS=agus@zorvi.com,nico@zorvi.com,juanchi@zorvi.com,mariano@zorvi.com
